import Mathlib

/-!
# Paper-Facing Theorems: AI, Human Cognition and Knowledge Collapse

This file is the implementation theorem layer for the source paper. Keep
source-faithful definitions and theorem wrappers here, and expose only the
compact human-review subset in `PaperInterface.lean`.

During the statement-first phase, each exact paper-facing proposition lives in a
transparent `<name>Spec : Prop` declaration in `PaperInterface.lean`; the paired
theorem/lemma endpoint belongs in `ProofInterface.lean` and has exactly that
type. Add proof implementations here only after those specifications pass v11
raw-source-to-expanded-Spec review and recursive premise provenance audit. Before full closeout, the v11
realization audit independently binds pinned source atoms to the elaborated Spec
and accounts for the complete Lean closure; a proof hole or a declaration name
is never evidence for that correspondence.
-/

namespace AKO26KnowledgeCollapse


/-- Analytic assumptions on the abstract accuracy function used in T2. -/
structure AccuracyAssumptions (G g gPrime : ℝ → ℝ) : Prop where
  /-- Zero precision gives zero probability of an accurate prediction. -/
  G_zero : G 0 = 0
  /-- On positive precisions, `g` is the derivative of the accuracy function `G`. -/
  hasDerivAt_G : ∀ tau : ℝ, 0 < tau → HasDerivAt G (g tau) tau
  /-- The marginal accuracy gain is positive at every positive precision. -/
  g_pos : ∀ tau : ℝ, 0 < tau → 0 < g tau
  /-- On positive precisions, `gPrime` is the derivative of `g`. -/
  hasDerivAt_g : ∀ tau : ℝ, 0 < tau → HasDerivAt g (gPrime tau) tau
  /-- The derivative of marginal accuracy is negative at every positive precision. -/
  gPrime_neg : ∀ tau : ℝ, 0 < tau → gPrime tau < 0

/-- The marginal increase in Gaussian accuracy generated by an additional unit of precision. -/
noncomputable def gAKO (tau : ℝ) : ℝ :=
  (Real.sqrt (2 * Real.pi))⁻¹ * tau ^ (-(1 / 2 : ℝ)) * Real.exp (-tau / 2)

/-- T1: `gAKO` is positive and strictly decreasing at every positive precision. -/
def t1SubstitutionEngineSpec : Prop :=
  (∀ tau : ℝ, 0 < tau → 0 < gAKO tau) ∧
    StrictAntiOn gAKO (Set.Ioi 0)

/-- Posterior precision about the idiosyncratic state. -/
def idiosyncraticPrecision
    (sigInv2 lamI effort tauA : ℝ) : ℝ :=
  sigInv2 + lamI * effort + tauA

/-- The baseline marginal benefit of human learning effort under `DeltaI = 0`. -/
def marginalBenefitBaseline
    (G g : ℝ → ℝ) (DeltaX lamI sigInv2 effort X tauA : ℝ) : ℝ :=
  DeltaX * G X * lamI * g (idiosyncraticPrecision sigInv2 lamI effort tauA)

/-- Marginal benefit when context-specific knowledge has stand-alone value `DeltaI`. -/
def marginalBenefitWithStandaloneValue
    (G g : ℝ → ℝ) (DeltaI DeltaX lamI sigInv2 effort X tauA : ℝ) : ℝ :=
  (DeltaI + DeltaX * G X) * lamI *
    g (idiosyncraticPrecision sigInv2 lamI effort tauA)

/-- The derivative and increasing-differences forms of baseline Observation 1. -/
structure ObservationOneBaselineClaims
    (G g gPrime : ℝ → ℝ)
    (DeltaX lamI sigInv2 effort tauA : ℝ) : Prop where
  /-- General knowledge strictly raises the marginal benefit of effort. -/
  crossPartialX :
    ∀ X : ℝ, 0 < X →
      HasDerivAt
          (fun x ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 effort x tauA)
          (DeltaX * g X * lamI *
            g (idiosyncraticPrecision sigInv2 lamI effort tauA)) X ∧
        0 < DeltaX * g X * lamI *
          g (idiosyncraticPrecision sigInv2 lamI effort tauA)
  /-- Agentic-AI precision strictly lowers the marginal benefit of effort when `G X > 0`. -/
  crossPartialTauA :
    ∀ X : ℝ, 0 < G X →
      HasDerivAt
          (fun t ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X t)
          (DeltaX * G X * lamI *
            gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA)) tauA ∧
        DeltaX * G X * lamI *
          gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA) < 0
  /-- Baseline marginal benefit has strictly increasing differences in effort and knowledge. -/
  increasingDifferencesX :
    ∀ X X' : ℝ, 0 < X → X < X' →
      marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X tauA <
        marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X' tauA
  /-- Baseline marginal benefit has strictly decreasing differences in effort and AI precision. -/
  decreasingDifferencesTauA :
    ∀ X tauA' : ℝ, 0 < G X → tauA < tauA' →
      marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X tauA' <
        marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X tauA

/-- Observation 1 when context-specific knowledge has positive stand-alone value. -/
structure ObservationOneStandaloneClaims
    (G g gPrime : ℝ → ℝ)
    (DeltaI DeltaX lamI sigInv2 effort tauA : ℝ) : Prop where
  /-- General knowledge still strictly raises the marginal benefit of effort. -/
  crossPartialX :
    ∀ X : ℝ, 0 < X →
      HasDerivAt
          (fun x ↦ marginalBenefitWithStandaloneValue
            G g DeltaI DeltaX lamI sigInv2 effort x tauA)
          (DeltaX * g X * lamI *
            g (idiosyncraticPrecision sigInv2 lamI effort tauA)) X ∧
        0 < DeltaX * g X * lamI *
          g (idiosyncraticPrecision sigInv2 lamI effort tauA)
  /-- AI precision lowers marginal benefit whenever accuracy itself is nonnegative. -/
  crossPartialTauA :
    ∀ X : ℝ, 0 ≤ G X →
      HasDerivAt
          (fun t ↦ marginalBenefitWithStandaloneValue
            G g DeltaI DeltaX lamI sigInv2 effort X t)
          ((DeltaI + DeltaX * G X) * lamI *
            gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA)) tauA ∧
        (DeltaI + DeltaX * G X) * lamI *
          gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA) < 0
  /-- With `DeltaI > 0`, the negative AI cross-partial also holds at zero knowledge. -/
  crossPartialTauAAtZero :
    HasDerivAt
        (fun t ↦ marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort 0 t)
        ((DeltaI + DeltaX * G 0) * lamI *
          gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA)) tauA ∧
      (DeltaI + DeltaX * G 0) * lamI *
        gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA) < 0
  /-- Increasing differences in general knowledge survive when `DeltaI > 0`. -/
  increasingDifferencesX :
    ∀ X X' : ℝ, 0 < X → X < X' →
      marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort X tauA <
        marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort X' tauA
  /-- Decreasing differences in AI precision hold whenever accuracy is nonnegative. -/
  decreasingDifferencesTauA :
    ∀ X tauA' : ℝ, 0 ≤ G X → tauA < tauA' →
      marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort X tauA' <
        marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort X tauA
  /-- With `DeltaI > 0`, decreasing differences also hold at zero knowledge. -/
  decreasingDifferencesTauAAtZero :
    ∀ tauA' : ℝ, tauA < tauA' →
      marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort 0 tauA' <
        marginalBenefitWithStandaloneValue
          G g DeltaI DeltaX lamI sigInv2 effort 0 tauA

/-- T2: Observation 1 in derivative and increasing-differences form, including `DeltaI > 0`. -/
def t2ObservationOneSpec : Prop :=
  ∀ (G g gPrime : ℝ → ℝ),
    AccuracyAssumptions G g gPrime →
    ∀ (DeltaX lamI sigInv2 effort tauA : ℝ),
      0 < DeltaX → 0 < lamI → 0 < sigInv2 → 0 ≤ effort → 0 ≤ tauA →
      ObservationOneBaselineClaims
          G g gPrime DeltaX lamI sigInv2 effort tauA ∧
        ∀ DeltaI : ℝ, 0 < DeltaI →
          ObservationOneStandaloneClaims
            G g gPrime DeltaI DeltaX lamI sigInv2 effort tauA


/-- Marginal effort cost in the May 2026 parameterization. -/
noncomputable def marginalCost (eps effort : ℝ) : ℝ :=
  effort ^ (1 / eps)

/-- A nonnegative root of the baseline first-order condition, not an assumed optimizer. -/
def IsBaselineFOCRoot
    (G g : ℝ → ℝ) (DeltaX lamI sigInv2 eps X tauA effort : ℝ) : Prop :=
  0 ≤ effort ∧
    marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X tauA =
      marginalCost eps effort

/-- T3: strict comparative statics of existing FOC roots (Observation 2).
Positivity of G at the lower knowledge level is explicit: the abstract T2
assumptions do not alone imply positivity near zero without a boundary condition.
This does not establish existence of roots or equivalence with global maximizers. -/
def t3ObservationTwoRootSpec : Prop :=
  ∀ (G g gPrime : ℝ → ℝ),
    AccuracyAssumptions G g gPrime →
    ∀ (DeltaX lamI sigInv2 eps : ℝ),
      0 < DeltaX → 0 < lamI → 0 < sigInv2 → 0 < eps →
      (∀ X X' tauA e e' : ℝ, 0 < X → X < X' → 0 < G X → 0 ≤ tauA →
        IsBaselineFOCRoot G g DeltaX lamI sigInv2 eps X tauA e →
        IsBaselineFOCRoot G g DeltaX lamI sigInv2 eps X' tauA e' → e < e') ∧
      (∀ X tauA tauA' e e' : ℝ, 0 < G X → 0 ≤ tauA → tauA < tauA' →
        IsBaselineFOCRoot G g DeltaX lamI sigInv2 eps X tauA e →
        IsBaselineFOCRoot G g DeltaX lamI sigInv2 eps X tauA' e' → e' < e)

/-- Public precision after depreciation; K = lambda_G * I.
The rational form gives the continuous economic extension at zero input.
Using inverse-of-inverse directly at zero in Lean would produce the wrong value. -/
noncomputable def publicPrecisionNext (Sigma2 K X effort : ℝ) : ℝ :=
  (X + K * effort) / (1 + Sigma2 * (X + K * effort))

/-- The effort needed to maintain a strictly positive public precision. -/
noncomputable def maintenanceEffort (Sigma2 K X : ℝ) : ℝ :=
  Sigma2 * X ^ 2 / (K * (1 - Sigma2 * X))

/-- T4: exact maintenance-effort factorization and strict comparison. -/
def t4MaintenanceSpec : Prop :=
  ∀ Sigma2 K X effort : ℝ,
    0 < Sigma2 → 0 < K → 0 < X → Sigma2 * X < 1 → 0 ≤ effort →
      (publicPrecisionNext Sigma2 K X effort - X =
        K * (1 - Sigma2 * X) * (effort - maintenanceEffort Sigma2 K X) /
          (1 + Sigma2 * (X + K * effort))) ∧
      (X < publicPrecisionNext Sigma2 K X effort ↔
        maintenanceEffort Sigma2 K X < effort)

/-- T6: zero precision is not a fixed point when effort is positive there.
The premise eBR(0)>0 still needs an economic optimality proof. -/
def t6PositiveEffortAtZeroSpec : Prop :=
  ∀ Sigma2 K effort : ℝ, 0 < Sigma2 → 0 < K → 0 < effort →
    0 < publicPrecisionNext Sigma2 K 0 effort

/-- The planner's value, over a fixed nonempty set of feasible paths represented
by a type. Finiteness is imposed as boundedness in the comparison theorem. -/
noncomputable def plannerValue {Path : Type} (W : Path → ℝ → ℝ) (tauA : ℝ) : ℝ :=
  sSup (Set.range fun path : Path ↦ W path tauA)

/-- T7: a common feasible set and pathwise nondecreasing payoff imply
nondecreasing optimal value, whenever the value is finite. This is an abstract
order lemma, not the derivation of pathwise monotonicity in the AKO model. -/
def t7PlannerValueSpec : Prop :=
  ∀ (Path : Type) [Nonempty Path] (W : Path → ℝ → ℝ),
    (∀ path : Path, MonotoneOn (W path) (Set.Ici 0)) →
    (∀ tauA : ℝ, 0 ≤ tauA → BddAbove (Set.range fun path : Path ↦ W path tauA)) →
    MonotoneOn (plannerValue W) (Set.Ici 0)

/-- T1 holds for the concrete Gaussian marginal-accuracy function. -/
theorem t1SubstitutionEngine_holds : t1SubstitutionEngineSpec := by
  constructor
  · intro tau htau
    unfold gAKO
    have hsqrt : 0 < Real.sqrt (2 * Real.pi) := by
      exact Real.sqrt_pos.2 (mul_pos (by norm_num) Real.pi_pos)
    exact mul_pos
      (mul_pos (inv_pos.mpr hsqrt) (Real.rpow_pos_of_pos htau _))
      (Real.exp_pos _)
  · intro a ha b _ hab
    unfold gAKO
    have hsqrt : 0 < Real.sqrt (2 * Real.pi) := by
      exact Real.sqrt_pos.2 (mul_pos (by norm_num) Real.pi_pos)
    have hconstant : 0 < (Real.sqrt (2 * Real.pi))⁻¹ := inv_pos.mpr hsqrt
    have hrpow : b ^ (-(1 / 2 : ℝ)) < a ^ (-(1 / 2 : ℝ)) := by
      exact Real.rpow_lt_rpow_of_neg ha hab (by norm_num)
    have hexp : Real.exp (-b / 2) < Real.exp (-a / 2) := by
      apply Real.exp_lt_exp.mpr
      linarith
    calc
      (Real.sqrt (2 * Real.pi))⁻¹ * b ^ (-(1 / 2 : ℝ)) * Real.exp (-b / 2) <
          (Real.sqrt (2 * Real.pi))⁻¹ * a ^ (-(1 / 2 : ℝ)) * Real.exp (-b / 2) := by
            exact mul_lt_mul_of_pos_right
              (mul_lt_mul_of_pos_left hrpow hconstant) (Real.exp_pos _)
      _ < (Real.sqrt (2 * Real.pi))⁻¹ * a ^ (-(1 / 2 : ℝ)) * Real.exp (-a / 2) := by
            exact mul_lt_mul_of_pos_left hexp
              (mul_pos hconstant (Real.rpow_pos_of_pos ha _))

private lemma accuracy_strictMonoOn
    {G g gPrime : ℝ → ℝ} (h : AccuracyAssumptions G g gPrime) :
    StrictMonoOn G (Set.Ioi 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ioi 0)
  · intro x hx
    exact (h.hasDerivAt_G x hx).continuousAt.continuousWithinAt
  · intro x hx
    have hx' : 0 < x := by simpa using hx
    rw [(h.hasDerivAt_G x hx').deriv]
    exact h.g_pos x hx'

private lemma marginalAccuracy_strictAntiOn
    {G g gPrime : ℝ → ℝ} (h : AccuracyAssumptions G g gPrime) :
    StrictAntiOn g (Set.Ioi 0) := by
  apply strictAntiOn_of_deriv_neg (convex_Ioi 0)
  · intro x hx
    exact (h.hasDerivAt_g x hx).continuousAt.continuousWithinAt
  · intro x hx
    have hx' : 0 < x := by simpa using hx
    rw [(h.hasDerivAt_g x hx').deriv]
    exact h.gPrime_neg x hx'

/-- T2 holds under the paper's abstract analytic and economic assumptions. -/
theorem t2ObservationOne_holds : t2ObservationOneSpec := by
  intro G g gPrime h DeltaX lamI sigInv2 effort tauA
    hDeltaX hLamI hSigInv2 hEffort hTauA
  have hY : 0 < idiosyncraticPrecision sigInv2 lamI effort tauA := by
    unfold idiosyncraticPrecision
    have hLearning : 0 ≤ lamI * effort := mul_nonneg hLamI.le hEffort
    linarith
  have hInner :
      HasDerivAt
        (fun t : ℝ ↦ idiosyncraticPrecision sigInv2 lamI effort t) 1 tauA := by
    simpa [idiosyncraticPrecision] using
      (hasDerivAt_id tauA).const_add (sigInv2 + lamI * effort)
  have hMarginalComposition :
      HasDerivAt
        (fun t : ℝ ↦ g (idiosyncraticPrecision sigInv2 lamI effort t))
        (gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA)) tauA := by
    simpa using
      (h.hasDerivAt_g
        (idiosyncraticPrecision sigInv2 lamI effort tauA) hY).comp tauA hInner
  have hGMono : StrictMonoOn G (Set.Ioi 0) := accuracy_strictMonoOn h
  have hgAnti : StrictAntiOn g (Set.Ioi 0) := marginalAccuracy_strictAntiOn h
  constructor
  · refine
      { crossPartialX := ?_
        crossPartialTauA := ?_
        increasingDifferencesX := ?_
        decreasingDifferencesTauA := ?_ }
    · intro X hX
      constructor
      · simpa [marginalBenefitBaseline] using
          (((h.hasDerivAt_G X hX).const_mul DeltaX).mul_const lamI).mul_const
            (g (idiosyncraticPrecision sigInv2 lamI effort tauA))
      · exact mul_pos
          (mul_pos (mul_pos hDeltaX (h.g_pos X hX)) hLamI)
          (h.g_pos (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
    · intro X hGX
      constructor
      · simpa [marginalBenefitBaseline] using
          hMarginalComposition.const_mul (DeltaX * G X * lamI)
      · exact mul_neg_of_pos_of_neg
          (mul_pos (mul_pos hDeltaX hGX) hLamI)
          (h.gPrime_neg (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
    · intro X X' hX hXX'
      have hX' : 0 < X' := lt_trans hX hXX'
      have hGXX' : G X < G X' := hGMono hX hX' hXX'
      have hFactor :
          0 < DeltaX * lamI *
            g (idiosyncraticPrecision sigInv2 lamI effort tauA) :=
        mul_pos (mul_pos hDeltaX hLamI)
          (h.g_pos (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
      calc
        marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X tauA =
            G X * (DeltaX * lamI *
              g (idiosyncraticPrecision sigInv2 lamI effort tauA)) := by
                unfold marginalBenefitBaseline
                ring
        _ < G X' * (DeltaX * lamI *
              g (idiosyncraticPrecision sigInv2 lamI effort tauA)) :=
            mul_lt_mul_of_pos_right hGXX' hFactor
        _ = marginalBenefitBaseline G g DeltaX lamI sigInv2 effort X' tauA := by
              unfold marginalBenefitBaseline
              ring
    · intro X tauA' hGX hTauLt
      have hTauA' : 0 ≤ tauA' := hTauA.trans (le_of_lt hTauLt)
      have hY' : 0 < idiosyncraticPrecision sigInv2 lamI effort tauA' := by
        unfold idiosyncraticPrecision
        have hLearning : 0 ≤ lamI * effort := mul_nonneg hLamI.le hEffort
        linarith
      have hYY' :
          idiosyncraticPrecision sigInv2 lamI effort tauA <
            idiosyncraticPrecision sigInv2 lamI effort tauA' := by
        unfold idiosyncraticPrecision
        linarith
      have hgYY' :
          g (idiosyncraticPrecision sigInv2 lamI effort tauA') <
            g (idiosyncraticPrecision sigInv2 lamI effort tauA) :=
        hgAnti hY hY' hYY'
      have hFactor : 0 < DeltaX * G X * lamI :=
        mul_pos (mul_pos hDeltaX hGX) hLamI
      exact mul_lt_mul_of_pos_left hgYY' hFactor
  · intro DeltaI hDeltaI
    have hStandaloneTau :
        ∀ X : ℝ, 0 ≤ G X →
          HasDerivAt
              (fun t ↦ marginalBenefitWithStandaloneValue
                G g DeltaI DeltaX lamI sigInv2 effort X t)
              ((DeltaI + DeltaX * G X) * lamI *
                gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA)) tauA ∧
            (DeltaI + DeltaX * G X) * lamI *
              gPrime (idiosyncraticPrecision sigInv2 lamI effort tauA) < 0 := by
      intro X hGX
      have hBracket : 0 < DeltaI + DeltaX * G X :=
        add_pos_of_pos_of_nonneg hDeltaI (mul_nonneg hDeltaX.le hGX)
      constructor
      · simpa [marginalBenefitWithStandaloneValue] using
          hMarginalComposition.const_mul ((DeltaI + DeltaX * G X) * lamI)
      · exact mul_neg_of_pos_of_neg (mul_pos hBracket hLamI)
          (h.gPrime_neg (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
    have hStandaloneTauDifferences :
        ∀ X tauA' : ℝ, 0 ≤ G X → tauA < tauA' →
          marginalBenefitWithStandaloneValue
              G g DeltaI DeltaX lamI sigInv2 effort X tauA' <
            marginalBenefitWithStandaloneValue
              G g DeltaI DeltaX lamI sigInv2 effort X tauA := by
      intro X tauA' hGX hTauLt
      have hTauA' : 0 ≤ tauA' := hTauA.trans (le_of_lt hTauLt)
      have hY' : 0 < idiosyncraticPrecision sigInv2 lamI effort tauA' := by
        unfold idiosyncraticPrecision
        have hLearning : 0 ≤ lamI * effort := mul_nonneg hLamI.le hEffort
        linarith
      have hYY' :
          idiosyncraticPrecision sigInv2 lamI effort tauA <
            idiosyncraticPrecision sigInv2 lamI effort tauA' := by
        unfold idiosyncraticPrecision
        linarith
      have hgYY' :
          g (idiosyncraticPrecision sigInv2 lamI effort tauA') <
            g (idiosyncraticPrecision sigInv2 lamI effort tauA) :=
        hgAnti hY hY' hYY'
      have hBracket : 0 < DeltaI + DeltaX * G X :=
        add_pos_of_pos_of_nonneg hDeltaI (mul_nonneg hDeltaX.le hGX)
      exact mul_lt_mul_of_pos_left hgYY' (mul_pos hBracket hLamI)
    refine
      { crossPartialX := ?_
        crossPartialTauA := hStandaloneTau
        crossPartialTauAAtZero := ?_
        increasingDifferencesX := ?_
        decreasingDifferencesTauA := hStandaloneTauDifferences
        decreasingDifferencesTauAAtZero := ?_ }
    · intro X hX
      constructor
      · simpa [marginalBenefitWithStandaloneValue] using
          (((((h.hasDerivAt_G X hX).const_mul DeltaX).const_add DeltaI).mul_const lamI).mul_const
            (g (idiosyncraticPrecision sigInv2 lamI effort tauA)))
      · exact mul_pos
          (mul_pos (mul_pos hDeltaX (h.g_pos X hX)) hLamI)
          (h.g_pos (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
    · have hGZeroNonneg : 0 ≤ G 0 := by rw [h.G_zero]
      exact hStandaloneTau 0 hGZeroNonneg
    · intro X X' hX hXX'
      have hX' : 0 < X' := lt_trans hX hXX'
      have hGXX' : G X < G X' := hGMono hX hX' hXX'
      have hBracket : DeltaI + DeltaX * G X < DeltaI + DeltaX * G X' :=
        by
          simpa [add_comm] using
            (add_lt_add_left (mul_lt_mul_of_pos_left hGXX' hDeltaX) DeltaI)
      have hFactor :
          0 < lamI * g (idiosyncraticPrecision sigInv2 lamI effort tauA) :=
        mul_pos hLamI
          (h.g_pos (idiosyncraticPrecision sigInv2 lamI effort tauA) hY)
      calc
        marginalBenefitWithStandaloneValue
            G g DeltaI DeltaX lamI sigInv2 effort X tauA =
          (DeltaI + DeltaX * G X) *
            (lamI * g (idiosyncraticPrecision sigInv2 lamI effort tauA)) := by
              unfold marginalBenefitWithStandaloneValue
              ring
        _ < (DeltaI + DeltaX * G X') *
            (lamI * g (idiosyncraticPrecision sigInv2 lamI effort tauA)) :=
          mul_lt_mul_of_pos_right hBracket hFactor
        _ = marginalBenefitWithStandaloneValue
            G g DeltaI DeltaX lamI sigInv2 effort X' tauA := by
              unfold marginalBenefitWithStandaloneValue
              ring
    · intro tauA' hTauLt
      have hGZeroNonneg : 0 ≤ G 0 := by rw [h.G_zero]
      exact hStandaloneTauDifferences 0 tauA' hGZeroNonneg hTauLt


/-- Strict upward shifts of the benefit curve move existing roots upward. -/
private theorem root_lt_of_benefit_shift
    {MB1 MB2 MC : ℝ → ℝ} {e1 e2 : ℝ}
    (hAnti : AntitoneOn MB1 (Set.Ici 0))
    (hMono : MonotoneOn MC (Set.Ici 0))
    (hShift : ∀ e : ℝ, 0 ≤ e → MB1 e < MB2 e)
    (he1 : 0 ≤ e1) (he2 : 0 ≤ e2)
    (hRoot1 : MB1 e1 = MC e1) (hRoot2 : MB2 e2 = MC e2) :
    e1 < e2 := by
  by_contra! h
  have hB : MB1 e1 ≤ MB1 e2 := hAnti he2 he1 h
  have hC : MC e2 ≤ MC e1 := hMono he2 he1 h
  have hS := hShift e2 he2
  linarith

/-- Diminishing marginal accuracy makes marginal learning benefits antitone
in effort whenever the prefactor is nonnegative. -/
private theorem baselineBenefit_antitone_effort
    {G g gPrime : ℝ → ℝ} (h : AccuracyAssumptions G g gPrime)
    {DeltaX lamI sigInv2 X tauA : ℝ}
    (hDX : 0 < DeltaX) (hL : 0 < lamI) (hS : 0 < sigInv2)
    (hGX : 0 ≤ G X) (hA : 0 ≤ tauA) :
    AntitoneOn (fun e ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 e X tauA)
      (Set.Ici 0) := by
  intro e1 he1 e2 he2 he12
  have he1' : 0 ≤ e1 := he1
  have he2' : 0 ≤ e2 := he2
  have hy1 : 0 < idiosyncraticPrecision sigInv2 lamI e1 tauA := by
    unfold idiosyncraticPrecision
    have := mul_nonneg hL.le he1'
    linarith
  have hy2 : 0 < idiosyncraticPrecision sigInv2 lamI e2 tauA := by
    unfold idiosyncraticPrecision
    have := mul_nonneg hL.le he2'
    linarith
  have hyy : idiosyncraticPrecision sigInv2 lamI e1 tauA ≤
      idiosyncraticPrecision sigInv2 lamI e2 tauA := by
    unfold idiosyncraticPrecision
    have := mul_le_mul_of_nonneg_left he12 hL.le
    linarith
  have hg := (marginalAccuracy_strictAntiOn h).antitoneOn hy1 hy2 hyy
  unfold marginalBenefitBaseline
  exact mul_le_mul_of_nonneg_left hg
    (mul_nonneg (mul_nonneg hDX.le hGX) hL.le)

theorem t3ObservationTwoRoot_holds : t3ObservationTwoRootSpec := by
  intro G g gPrime h DeltaX lamI sigInv2 eps hDX hL hS hEps
  have hMC : MonotoneOn (marginalCost eps) (Set.Ici 0) := by
    intro a ha b _ hab
    unfold marginalCost
    exact Real.rpow_le_rpow ha hab (div_nonneg zero_le_one hEps.le)
  constructor
  · intro X X' tauA e e' hX hXX' hGX hA hR hR'
    apply root_lt_of_benefit_shift
      (MB1 := fun u ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 u X tauA)
      (MB2 := fun u ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 u X' tauA)
      (baselineBenefit_antitone_effort h hDX hL hS hGX.le hA) hMC
      _ hR.1 hR'.1 hR.2 hR'.2
    intro effort he
    exact ((t2ObservationOne_holds G g gPrime h DeltaX lamI sigInv2 effort tauA
      hDX hL hS he hA).1.increasingDifferencesX X X' hX hXX')
  · intro X tauA tauA' e e' hGX hA hAA' hR hR'
    have hA' : 0 ≤ tauA' := hA.trans hAA'.le
    apply root_lt_of_benefit_shift
      (MB1 := fun u ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 u X tauA')
      (MB2 := fun u ↦ marginalBenefitBaseline G g DeltaX lamI sigInv2 u X tauA)
      (baselineBenefit_antitone_effort h hDX hL hS hGX.le hA') hMC
      _ hR'.1 hR.1 hR'.2 hR.2
    intro effort he
    exact ((t2ObservationOne_holds G g gPrime h DeltaX lamI sigInv2 effort tauA
      hDX hL hS he hA).1.decreasingDifferencesTauA X tauA' hGX hAA')

/-- The maintenance-effort identity uses a denominator whose positivity follows
from the economic domain. -/
theorem t4Maintenance_holds : t4MaintenanceSpec := by
  intro Sigma2 K X effort hS hK hX hSX he
  have hD : 0 < 1 - Sigma2 * X := sub_pos.mpr hSX
  have hFactor : 0 < K * (1 - Sigma2 * X) := mul_pos hK hD
  have hZ : 0 < X + K * effort := add_pos_of_pos_of_nonneg hX (mul_nonneg hK.le he)
  have hDen : 0 < 1 + Sigma2 * (X + K * effort) :=
    add_pos zero_lt_one (mul_pos hS hZ)
  have hM : K * (1 - Sigma2 * X) * maintenanceEffort Sigma2 K X =
      Sigma2 * X ^ 2 := by
    unfold maintenanceEffort
    field_simp [hFactor.ne']
  have hIdentity : publicPrecisionNext Sigma2 K X effort - X =
      K * (1 - Sigma2 * X) * (effort - maintenanceEffort Sigma2 K X) /
        (1 + Sigma2 * (X + K * effort)) := by
    apply (eq_div_iff hDen.ne').2
    unfold publicPrecisionNext
    calc
      ((X + K * effort) / (1 + Sigma2 * (X + K * effort)) - X) *
          (1 + Sigma2 * (X + K * effort)) =
        K * (1 - Sigma2 * X) * effort - Sigma2 * X ^ 2 := by
          field_simp [hDen.ne'] <;> ring
      _ = K * (1 - Sigma2 * X) * (effort - maintenanceEffort Sigma2 K X) := by
          rw [mul_sub (K * (1 - Sigma2 * X)) effort (maintenanceEffort Sigma2 K X), hM]
  refine ⟨hIdentity, ?_⟩
  constructor
  · intro hlt
    by_contra! hnot
    have hn := div_nonpos_of_nonpos_of_nonneg
      (mul_nonpos_of_nonneg_of_nonpos hFactor.le (sub_nonpos.mpr hnot)) hDen.le
    have hp : 0 < publicPrecisionNext Sigma2 K X effort - X := sub_pos.mpr hlt
    rw [hIdentity] at hp
    linarith
  · intro hlt
    have hp : 0 < publicPrecisionNext Sigma2 K X effort - X := by
      rw [hIdentity]
      exact div_pos (mul_pos hFactor (sub_pos.mpr hlt)) hDen
    exact sub_pos.mp hp

/-- The rational transition gives the intended zero-knowledge boundary. -/
theorem publicPrecisionNext_zero (Sigma2 K : ℝ) :
    publicPrecisionNext Sigma2 K 0 0 = 0 := by
  simp [publicPrecisionNext]

theorem t6PositiveEffortAtZero_holds : t6PositiveEffortAtZeroSpec := by
  intro Sigma2 K effort hS hK he
  unfold publicPrecisionNext
  positivity

theorem t7PlannerValue_holds : t7PlannerValueSpec := by
  intro Path _ W hMono hBound a ha b hb hab
  unfold plannerValue
  apply csSup_le (Set.range_nonempty _)
  rintro _ ⟨path, rfl⟩
  exact le_trans (hMono path ha hb hab)
    (le_csSup (hBound b hb) ⟨path, rfl⟩)

